# Database Configuration
# For Docker Compose (from within container): postgresql://app:app@db:5432/rules
# For local development: postgresql://app:app@localhost:5432/rules
PG_DSN=postgresql://app:app@localhost:5432/rules

# FAISS Index Configuration
INDEX_PATH=./faiss.index

# Embedding Model Configuration
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Application Settings
DEBUG=False
APP_NAME=Provider Rules RAG

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
